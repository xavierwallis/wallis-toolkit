    {
      "parameters": {
        "language": "python",
        "pythonCode": "import pandas\nimport io\n\nschedule = pandas.DataFrame( _('HTTP Request').first().json.week.games )\n \nschedule['starts_at'] = pandas.to_datetime(schedule['scheduled'])\nschedule['starts_at'] = schedule['starts_at'].dt.tz_convert('America/New_York')\ncsv_string = io.StringIO( _('name-to-icon-map').first().json['name-to-icon-map.csv'] )\nabbreviations = pandas.read_csv( csv_string ).set_index('abbreviation')\n\nhome = list(schedule['home'])\naway = list(schedule['away'])\nabbreviation = lambda x: {'abbreviation': x['alias'], 'name': x['name'], 'icon':abbreviations.loc[x['alias']].icon}\nhome = [ abbreviation( x ) for x in home ]\n#home = home.map(lambda x: {'abbreviation': x['alias'], 'name': x['name'], 'icon':abbreviations.loc[x['alias']].icon})\naway = [ abbreviation( x ) for x in away ]\n\nschedule['home'] = home\nschedule['away'] = away\n\nschedule['starts_at'] = schedule['starts_at'].dt.strftime('%Y-%m-%d %H:%M:%S')\nschedule['date'] = schedule['starts_at'].str.split(' ').str[0]\n\nreturn schedule.to_dict( orient='records' )\n"
      },
