    {
      "parameters": {
        "jsCode": "// Define start date of week 1 (Tuesday before season opener)\nconst seasonStart = new Date('2025-09-02T00:00:00-04:00'); // Eastern Time\nconst now = new Date();\n\n// Calculate difference in days\nconst diffDays = Math.floor((now - seasonStart) / (1000 * 60 * 60 * 24));\n\n// Calculate current NFL week (1-indexed)\nlet currentWeek = Math.floor(diffDays / 7) + 1;\n\n// Safety clamp: NFL regular season has 18 weeks\nif (currentWeek < 1) currentWeek = 1;\nif (currentWeek > 18) currentWeek = 18;\n\n// If it's Tuesday before Sportradar updates, bump to next week\n// (Assumes run time ~2 AM Tuesday)\nif (now.getDay() === 2 && now.getHours() < 6) {\n  currentWeek += 1;\n}\n\n// Build your Sportradar URL\nconst url = `https://api.sportradar.com/nfl/official/trial/v7/en/games/2025/REG/${currentWeek}/schedule.json`;\n\nreturn { url, currentWeek };\n"
      },
