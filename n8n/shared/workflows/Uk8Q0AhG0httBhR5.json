    {
      "parameters": {
        "jsCode": "// Get all incoming items (from API node)\nconst items = $input.all();\n\n// Random string generator (safe alphanumerics)\nfunction randomString(length = 10) {\n  const uppers = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';\n  const lowers = 'abcdefghijklmnopqrstuvwxyz';\n  const nums = '0123456789';\n  const all = uppers + lowers + nums;\n\n  // ensure requirements\n  const result = [\n    uppers[Math.floor(Math.random() * uppers.length)],\n    lowers[Math.floor(Math.random() * lowers.length)],\n    nums[Math.floor(Math.random() * nums.length)]\n  ];\n\n  // fill remaining\n  while (result.length < Math.max(length, 9)) {\n    result.push(all[Math.floor(Math.random() * all.length)]);\n  }\n\n  // shuffle to randomize order\n  for (let i = result.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [result[i], result[j]] = [result[j], result[i]];\n  }\n\n  return result.join('');\n}\n\nreturn items.map(item => {\n  return {\n    json: {\n      ...item.json,\n      email: randomString(16),  // add random string\n    }\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
