      "parameters": {
        "jsCode": "// Generate ~26-char alphanumeric clientId\nfunction generateClientId(length = 26) {\n  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\n  let id = '';\n  for (let i = 0; i < length; i++) {\n    id += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n  return id;\n}\n\nreturn [{ json: { clientId: generateClientId() } }];\n"
