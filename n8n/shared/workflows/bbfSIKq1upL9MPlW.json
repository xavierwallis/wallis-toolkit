    },
    {
      "parameters": {
        "url": "=https://api.sportradar.com/nhl/trial/v7/en/games/{{ $('Today\\'s Date').item.json.year }}/{{ $('Today\\'s Date').item.json.month }}/{{ $('Today\\'s Date').item.json.day }}/schedule.json",
        "sendHeaders": true,
        "headerParameters": {
