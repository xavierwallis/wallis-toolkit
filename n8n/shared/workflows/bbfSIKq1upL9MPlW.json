            {
              "name": "x-api-key",
              "value": "={{ $json.keys[0] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        608,
        32
      ],
      "id": "b31ba4bf-06ea-483e-b919-e907dea3e939",
      "name": "HTTP Request",
      "retryOnFail": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import pandas\nimport io\n\nschedule = pandas.DataFrame( _('HTTP Request').first().json.games )\nschedule['starts_at'] = pandas.to_datetime(schedule['scheduled'])\nschedule['starts_at'] = schedule['starts_at'].dt.tz_convert('America/New_York')\nschedule['starts_at'] = schedule['starts_at'].dt.strftime('%Y-%m-%d %H:%M:%S')\n\n\ncsv_string = io.StringIO( _('name-to-icon-map').first().json['name-to-icon-map.csv'] )\nabbreviations = pandas.read_csv( csv_string ).set_index('abbreviation')\n\nhome = list(schedule['home'])\naway = list(schedule['away'])\nabbreviation = lambda x: {'abbreviation': x['alias'], 'name': x['name'], 'icon':abbreviations.loc[x['alias']].icon}\nhome = [ abbreviation( x ) for x in home ]\naway = [ abbreviation( x ) for x in away ]\n\nschedule['home'] = home\nschedule['away'] = away\n\nreturn schedule.to_dict( orient='records' )\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
