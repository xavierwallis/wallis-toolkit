      "typeVersion": 4.2,
      "position": [
        -640,
        -96
      ],
      "id": "da4b809f-3a40-40e7-90ed-f584dc366a50",
      "name": "HTTP Request",
      "retryOnFail": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import pandas\nimport io\n\nschedule = pandas.DataFrame(_('HTTP Request').first().json['games'])\nschedule['starts_at'] = pandas.to_datetime(schedule['scheduled'])\nschedule['starts_at'] = schedule['starts_at'].dt.tz_convert('America/New_York')\n\ncsv_string = io.StringIO(_('name-to-icon-map').first().json['name-to-icon-map.csv'])\nabbreviations = pandas.read_csv(csv_string).set_index('name')['icon']\n\ndef get_icon(name):\n    return abbreviations.get(name, None)  # avoid KeyError\n\ndef map_team(team):\n    return {'name': f\"{team['market']} {team['name']}\", 'icon': get_icon(team['abbr'])}\n\nschedule['home'] = [map_team(x) for x in schedule['home']]\nschedule['away'] = [map_team(x) for x in schedule['away']]\n\nschedule['starts_at'] = schedule['starts_at'].dt.strftime('%Y-%m-%d %H:%M:%S')\nschedule['date'] = schedule['starts_at'].str.split(' ').str[0]\n\nreturn schedule.to_dict(orient='records')\n"
      },
