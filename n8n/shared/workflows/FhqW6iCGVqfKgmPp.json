      "parameters": {
        "url": "=https://api.sportradar.com/mlb/trial/v8/en/games/{{ $('Today\\'s Date').item.json.year }}/{{ $('Today\\'s Date').item.json.month }}/{{ $('Today\\'s Date').item.json.day }}/schedule.json",
